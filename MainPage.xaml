<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiApp1.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,25"
            Spacing="15">

            <Label
                Text="Rejestruj konto"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                Margin="0,0,0,15" />

            <Label Text="Podaj e-mail:" FontSize="16" />

            <Entry
                x:Name="EmailEntry"
                Placeholder="email"
                Keyboard="Email"
                ClearButtonVisibility="WhileEditing" />

            <Label Text="Podaj hasło:" FontSize="16" />

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Hasło"
                IsPassword="True" />

            <Label Text="Powtórz hasło:" FontSize="16" />

            <Entry
                x:Name="RepeatPasswordEntry"
                Placeholder="Powtórz hasło"
                IsPassword="True" />

            <Button
                x:Name="SubmitButton"
                Text="ZATWIERDŹ"
                Clicked="OnSubmitClicked"
                HorizontalOptions="Center"
                WidthRequest="180"
                Margin="0,15,0,0" />

            <Label
                x:Name="MessageLabel"
                Text="Autor:1234567890"
                FontSize="16"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Fill"
                Margin="0,10,0,0" />

            <Button
                x:Name="NextButton"
                Text="Dalej"
                IsVisible="False"
                Clicked="OnNextClicked"
                HorizontalOptions="Center"
                WidthRequest="180" />   

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>